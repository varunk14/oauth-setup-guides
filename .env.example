# Copy to .env (never commit real values). Keys are read by the backend only.
# Run locally with: ENV_FILE=../.env uv run uvicorn app.main:app --port 8000
# Values in ENV_FILE take priority over variables already exported in your shell.

# Primary: OpenAI with its built-in web search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Backup, used automatically if OpenAI fails: Gemini (writing) + Tavily (search).
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
TAVILY_API_KEY=

# Optional limits (defaults shown).
AGENT_MAX_SEARCHES=8
AGENT_RUN_TIMEOUT_S=240
AGENT_RUNS_PER_IP_PER_HOUR=3
AGENT_RUNS_PER_DAY=25
# Where live-generated guides are stored (default: data/generated).
GENERATED_DIR=
